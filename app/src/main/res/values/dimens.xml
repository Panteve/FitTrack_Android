<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Espaciado -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">12dp</dimen>
    <dimen name="spacing_lg">14dp</dimen>
    <dimen name="spacing_xl">16dp</dimen>
    <dimen name="spacing_xxl">24dp</dimen>

    <!-- Tamaños de componentes -->
    <dimen name="button_height_compact">36dp</dimen>
    <dimen name="button_height_standard">48dp</dimen>
    <dimen name="button_height_primary">48dp</dimen>
    <dimen name="bottom_navigation_height">56dp</dimen>
    <dimen name="border_width">1dp</dimen>

    <!-- Número de serie: recuadro cuadrado que se alinea con los campos de la serie. -->
    <dimen name="badge_number_size">24dp</dimen>

    <!-- Columna del check de la serie: se usa en la fila de la serie y en la cabecera
         de columnas de la tarjeta, para que las etiquetas queden alineadas. -->
    <dimen name="check_serie_width">40dp</dimen>

    <!-- Avatar circular del perfil: tamaño total y relleno que deja ver el ícono de persona. -->
    <dimen name="avatar_size">96dp</dimen>
    <dimen name="avatar_icon_padding">26dp</dimen>

    <!-- Resumen del entrenamiento: área de escritura y vista previa provisional. -->
    <dimen name="note_input_min_height">96dp</dimen>
    <dimen name="workout_photo_preview_size">72dp</dimen>

    <!-- Barra de herramientas: espacio que se reserva a cada lado del título
         para que quede centrado y nunca debajo de la flecha ni del botón de acción. -->
    <dimen name="toolbar_side_reserved">88dp</dimen>
    <!-- Cuando la pantalla usa dos botones de acción (Crear ejercicio y Guardar), el título
    necesita más espacio a la derecha para no quedar debajo de ellos. -->
    <dimen name="toolbar_side_reserved_doble_accion">128dp</dimen>
    <dimen name="elevation_card">2dp</dimen>
    <dimen name="elevation_button">2dp</dimen>

    <!-- Forma -->
    <dimen name="corner_radius_small">2dp</dimen>
    <dimen name="corner_radius_default">3dp</dimen>

    <!-- Tipografía -->
    <dimen name="text_size_caption">10sp</dimen>
    <dimen name="text_size_label">11sp</dimen>
    <dimen name="text_size_small">12sp</dimen>
    <dimen name="text_size_body">14sp</dimen>
    <dimen name="text_size_subtitle">16sp</dimen>
    <dimen name="text_size_title">20sp</dimen>
    <dimen name="text_size_metric">24sp</dimen>
    <dimen name="text_size_metric_large">32sp</dimen>
</resources>
