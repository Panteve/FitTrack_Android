<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/svPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/layoutContenidoPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg">

        <!-- Tarjeta de perfil: foto y datos personales -->
        <LinearLayout
            style="@style/FitTrack.Container.Card"
            android:id="@+id/layoutTarjetaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Foto circular con indicador de cámara -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md">

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_circle_image"
                    android:clipToOutline="true"
                    android:contentDescription="@string/cdFotoPerfil"
                    android:padding="@dimen/avatar_icon_padding"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person_teal" />

                <ImageButton
                    android:id="@+id/btnIconoCambiarFoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_primary"
                    android:contentDescription="@string/cdCambiarFoto"
                    android:elevation="2dp"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/colorOnPrimary" />
            </FrameLayout>

            <Button
                android:id="@+id/btnCambiarFoto"
                style="@style/FitTrack.Button.Compact"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_compact"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/btnCambiarFoto" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@color/colorDivider" />

            <!-- Nombre editable -->
            <TextView
                style="@style/FitTrack.Text.Subtitle"
                android:id="@+id/tvLabelDatosPersonales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tvLabelDatosPersonales" />

            <TextView
                style="@style/FitTrack.Text.Label"
                android:id="@+id/tvLabelNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tvLabelNombrePerfil" />

            <EditText
                android:id="@+id/etNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="@dimen/spacing_xs"
                android:autofillHints="name"
                android:background="@drawable/bg_input"
                android:hint="@string/etNombrePerfil_hint"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/spacing_md"
                android:singleLine="true"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextStrong"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGuardarNombre"
                style="@style/FitTrack.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/btnGuardarNombre" />

            <!-- Correo: solo lectura, no es un campo editable -->
            <TextView
                style="@style/FitTrack.Text.Label"
                android:id="@+id/tvLabelCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:text="@string/tvLabelCorreoPerfil" />

            <TextView
                android:id="@+id/tvCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:drawablePadding="@dimen/spacing_sm"
                android:text="@string/tvCorreoPerfil"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_mail"
                app:drawableTint="@color/colorTextTertiary" />
        </LinearLayout>

        <!-- Lista de ejercicios de la rutina con divisores -->
        <LinearLayout
            android:id="@+id/cardListaEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutListaHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorSurfaceHeader"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_sm">

                <TextView
                    android:id="@+id/tvTituloLista"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tvTituloLista"
                    android:textColor="@color/colorTextStrong"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtituloLista"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tvSubtituloLista"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorBorder" />

            <!-- Ejercicio 1 -->
            <LinearLayout
                android:id="@+id/layoutEjercicio1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvNumeroEjercicio1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_number_badge"
                    android:gravity="center"
                    android:text="@string/tvNumeroEjercicio1"
                    android:textColor="@color/colorTextStrong"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreEjercicio1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tvNombreEjercicio1"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGrupoMuscularEjercicio1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tvGrupoMuscularEjercicio1"
                        android:textColor="@color/colorTextTertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgReorder1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/tvNombreEjercicio1"
                    android:src="@drawable/ic_reorder"
                    app:tint="@color/colorTextDisabled" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider" />

            <!-- Ejercicio 2 -->
            <LinearLayout
                android:id="@+id/layoutEjercicio2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvNumeroEjercicio2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_number_badge"
                    android:gravity="center"
                    android:text="@string/tvNumeroEjercicio2"
                    android:textColor="@color/colorTextStrong"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreEjercicio2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tvNombreEjercicio2"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGrupoMuscularEjercicio2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tvGrupoMuscularEjercicio2"
                        android:textColor="@color/colorTextTertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgReorder2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/tvNombreEjercicio2"
                    android:src="@drawable/ic_reorder"
                    app:tint="@color/colorTextDisabled" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider" />

            <!-- Ejercicio 3 -->
            <LinearLayout
                android:id="@+id/layoutEjercicio3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvNumeroEjercicio3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_number_badge"
                    android:gravity="center"
                    android:text="@string/tvNumeroEjercicio3"
                    android:textColor="@color/colorTextStrong"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreEjercicio3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tvNombreEjercicio3"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGrupoMuscularEjercicio3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tvGrupoMuscularEjercicio3"
                        android:textColor="@color/colorTextTertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgReorder3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/tvNombreEjercicio3"
                    android:src="@drawable/ic_reorder"
                    app:tint="@color/colorTextDisabled" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider" />

            <!-- Ejercicio 4 -->
            <LinearLayout
                android:id="@+id/layoutEjercicio4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tvNumeroEjercicio4"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_number_badge"
                    android:gravity="center"
                    android:text="@string/tvNumeroEjercicio4"
                    android:textColor="@color/colorTextStrong"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreEjercicio4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tvNombreEjercicio4"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGrupoMuscularEjercicio4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tvGrupoMuscularEjercicio4"
                        android:textColor="@color/colorTextTertiary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgReorder4"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/tvNombreEjercicio4"
                    android:src="@drawable/ic_reorder"
                    app:tint="@color/colorTextDisabled" />
            </LinearLayout>
        </LinearLayout>

        <!-- Crear un ejercicio nuevo -->
        <Button
            android:id="@+id/btnNuevoEjercicio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_compact"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_button_confirm"
            android:letterSpacing="0.05"
            android:text="@string/btnNuevoEjercicio"
            android:textAllCaps="true"
            android:textColor="@color/colorOnConfirm"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Acciones de la cuenta -->
        <TextView
            style="@style/FitTrack.Text.Subtitle"
            android:id="@+id/tvLabelCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:text="@string/tvLabelCuenta" />

        <Button
            android:id="@+id/btnCambiarContrasena"
            style="@style/FitTrack.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/btnCambiarContrasena" />

        <Button
            android:id="@+id/btnCambiarCuenta"
            style="@style/FitTrack.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/btnCambiarCuenta" />

        <!-- Cierre de sesión -->
        <Button
            android:id="@+id/btnCerrarSesion"
            style="@style/FitTrack.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/btnCerrarSesion" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl" />
    </LinearLayout>
</ScrollView>