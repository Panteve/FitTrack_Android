<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/svPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/layoutContenidoPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg">

        <!-- Tarjeta de perfil: foto y datos personales -->
        <LinearLayout
            style="@style/FitTrack.Container.Card"
            android:id="@+id/layoutTarjetaPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Foto circular con indicador de cámara -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md">

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_circle_image"
                    android:clipToOutline="true"
                    android:contentDescription="@string/cdFotoPerfil"
                    android:padding="@dimen/avatar_icon_padding"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person_teal" />

                <ImageButton
                    android:id="@+id/btnIconoCambiarFoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle_primary"
                    android:contentDescription="@string/cdCambiarFoto"
                    android:elevation="2dp"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/colorOnPrimary" />
            </FrameLayout>

            <Button
                android:id="@+id/btnCambiarFoto"
                style="@style/FitTrack.Button.Compact"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_compact"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/btnCambiarFoto" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/spacing_md"
                android:background="@color/colorDivider" />

            <!-- Nombre editable -->
            <TextView
                style="@style/FitTrack.Text.Subtitle"
                android:id="@+id/tvLabelDatosPersonales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tvLabelDatosPersonales" />

            <TextView
                style="@style/FitTrack.Text.Label"
                android:id="@+id/tvLabelNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tvLabelNombrePerfil" />

            <EditText
                android:id="@+id/etNombrePerfil"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="@dimen/spacing_xs"
                android:autofillHints="name"
                android:background="@drawable/bg_input"
                android:hint="@string/etNombrePerfil_hint"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="255"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/spacing_md"
                android:singleLine="true"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextStrong"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGuardarNombre"
                style="@style/FitTrack.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/btnGuardarNombre" />

            <!-- Correo: solo lectura, no es un campo editable -->
            <TextView
                style="@style/FitTrack.Text.Label"
                android:id="@+id/tvLabelCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:text="@string/tvLabelCorreoPerfil" />

            <TextView
                android:id="@+id/tvCorreoPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:drawablePadding="@dimen/spacing_sm"
                android:text="@string/tvCorreoPerfil"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_mail"
                app:drawableTint="@color/colorTextTertiary" />
        </LinearLayout>

        <!-- Ejercicios creados por el usuario -->
        <LinearLayout
            android:id="@+id/cardListaEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_card"
            android:elevation="@dimen/elevation_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutListaHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorSurfaceHeader"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_sm">

                <TextView
                    android:id="@+id/tvTituloLista"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/colorTextStrong"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtituloLista"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tvSubtituloLista"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorBorder" />

            <!-- Estados de carga, lista y lista vacía -->
            <ProgressBar
                android:id="@+id/pbCargaEjerciciosPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="@dimen/spacing_xxl"
                android:indeterminateTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvSinEjerciciosPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/spacing_xxl"
                android:text="@string/tvSinEjerciciosPerfil_loading"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEjerciciosPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Crear un ejercicio nuevo -->
        <Button
            android:id="@+id/btnNuevoEjercicio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_compact"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_button_confirm"
            android:letterSpacing="0.05"
            android:text="@string/btnNuevoEjercicio"
            android:textAllCaps="true"
            android:textColor="@color/colorOnConfirm"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Acciones de la cuenta -->
        <TextView
            style="@style/FitTrack.Text.Subtitle"
            android:id="@+id/tvLabelCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:text="@string/tvLabelCuenta" />

        <Button
            android:id="@+id/btnCambiarContrasena"
            style="@style/FitTrack.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/btnCambiarContrasena" />

        <!-- Cierre de sesión -->
        <Button
            android:id="@+id/btnCerrarSesion"
            style="@style/FitTrack.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/btnCerrarSesion" />

        <!-- Borrado de la cuenta: separado del cierre de sesión y en gris, porque es
             una acción destructiva que todavía no está disponible. -->
        <Button
            android:id="@+id/btnBorrarCuenta"
            style="@style/FitTrack.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:text="@string/btnBorrarCuenta" />

        <TextView
            android:id="@+id/tvAvisoBorrarCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/tvAvisoBorrarCuenta"
            android:textColor="@color/colorWarningText"
            android:textSize="@dimen/text_size_caption" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_xxl" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
