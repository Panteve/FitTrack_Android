<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutContenidoFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/svContenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Tarjeta de saludo: fecha y bienvenida -->
            <LinearLayout
                android:id="@+id/cardSaludo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:baselineAligned="false"
                android:elevation="@dimen/elevation_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tvFecha"
                        android:textColor="@color/colorTextTertiary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvBienvenida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/tvBienvenida"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgSaludo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_day_checked"
                    android:contentDescription="@null"
                    android:padding="@dimen/spacing_sm"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_local_fire_department"
                    app:tint="@color/colorPrimary" />
            </LinearLayout>

            <!-- Tarjeta 1: Registro semanal -->
            <LinearLayout
                android:id="@+id/cardRegistroSemanal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTituloRegistroSemanal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tvTituloRegistroSemanal"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBadgeDias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_teal"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="2dp"
                        android:text="@string/tvBadgeDias"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAyudaRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/tvAyudaRegistro"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="12sp" />

                <!-- Rejilla de 7 días -->
                <LinearLayout
                    android:id="@+id/layoutSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Lunes: asistido -->
                    <LinearLayout
                        android:id="@+id/layoutDiaLunes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_day_checked"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tvDiaLunes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvDiaLunes"
                            android:textColor="@color/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/imgCheckLunes"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginVertical="2dp"
                            android:contentDescription="@string/tvDiaLunes"
                            android:src="@drawable/ic_check_box"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tvNumeroLunes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNumeroLunes"
                            android:textColor="@color/colorPrimary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Martes: hoy -->
                    <LinearLayout
                        android:id="@+id/layoutDiaMartes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_day_today"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tvDiaMartes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvDiaMartes"
                            android:textColor="@color/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/imgCheckMartes"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginVertical="2dp"
                            android:contentDescription="@string/tvDiaMartes"
                            android:src="@drawable/ic_radio_button_checked"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tvNumeroMartes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNumeroMartes"
                            android:textColor="@color/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Miércoles -->
                    <LinearLayout
                        android:id="@+id/layoutDiaMiercoles"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_day_default"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tvDiaMiercoles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvDiaMiercoles"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/imgCheckMiercoles"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginVertical="2dp"
                            android:contentDescription="@string/tvDiaMiercoles"
                            android:src="@drawable/ic_check_box_outline_blank"
                            app:tint="@color/colorIconSubtle" />

                        <TextView
                            android:id="@+id/tvNumeroMiercoles"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNumeroMiercoles"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Jueves -->
                    <LinearLayout
                        android:id="@+id/layoutDiaJueves"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_day_default"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tvDiaJueves"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvDiaJueves"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/imgCheckJueves"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginVertical="2dp"
                            android:contentDescription="@string/tvDiaJueves"
                            android:src="@drawable/ic_check_box_outline_blank"
                            app:tint="@color/colorIconSubtle" />

                        <TextView
                            android:id="@+id/tvNumeroJueves"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNumeroJueves"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Viernes -->
                    <LinearLayout
                        android:id="@+id/layoutDiaViernes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_day_default"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tvDiaViernes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvDiaViernes"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/imgCheckViernes"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginVertical="2dp"
                            android:contentDescription="@string/tvDiaViernes"
                            android:src="@drawable/ic_check_box_outline_blank"
                            app:tint="@color/colorIconSubtle" />

                        <TextView
                            android:id="@+id/tvNumeroViernes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNumeroViernes"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Sábado -->
                    <LinearLayout
                        android:id="@+id/layoutDiaSabado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_day_weekend"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tvDiaSabado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvDiaSabado"
                            android:textColor="@color/colorTextDisabled"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/imgCheckSabado"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginVertical="2dp"
                            android:contentDescription="@string/tvDiaSabado"
                            android:src="@drawable/ic_check_box_outline_blank"
                            app:tint="@color/colorIconSubtle" />

                        <TextView
                            android:id="@+id/tvNumeroSabado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNumeroSabado"
                            android:textColor="@color/colorTextDisabled"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Domingo -->
                    <LinearLayout
                        android:id="@+id/layoutDiaDomingo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_day_weekend"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tvDiaDomingo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvDiaDomingo"
                            android:textColor="@color/colorTextDisabled"
                            android:textSize="11sp" />

                        <ImageView
                            android:id="@+id/imgCheckDomingo"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginVertical="2dp"
                            android:contentDescription="@string/tvDiaDomingo"
                            android:src="@drawable/ic_check_box_outline_blank"
                            app:tint="@color/colorIconSubtle" />

                        <TextView
                            android:id="@+id/tvNumeroDomingo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNumeroDomingo"
                            android:textColor="@color/colorTextDisabled"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta 2: Rutina asignada -->
            <LinearLayout
                android:id="@+id/cardRutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgIconoRutina"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_logo"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_fitness_center"
                        app:tint="@color/colorOnPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLabelRutina"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="@string/tvLabelRutina"
                            android:textColor="@color/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNombreRutina"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvNombreRutina"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCategoriaRutina"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvCategoriaRutina"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Fila de datos: duración | ejercicios | nivel -->
                <LinearLayout
                    android:id="@+id/layoutDatosRutina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_day_weekend"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_xs">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgDuracion"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@string/tvDuracionRutina"
                            android:src="@drawable/ic_schedule"
                            app:tint="@color/colorTextTertiary" />

                        <TextView
                            android:id="@+id/tvDuracionRutina"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/tvDuracionRutina"
                            android:textColor="@color/colorTextStrong"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSeparador1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tvSeparador1"
                        android:textColor="@color/colorIconSubtle"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgEjercicios"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@string/tvEjerciciosRutina"
                            android:src="@drawable/ic_format_list_numbered"
                            app:tint="@color/colorTextTertiary" />

                        <TextView
                            android:id="@+id/tvEjerciciosRutina"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/tvEjerciciosRutina"
                            android:textColor="@color/colorTextStrong"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSeparador2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tvSeparador2"
                        android:textColor="@color/colorIconSubtle"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgNivel"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@string/tvNivelRutina"
                            android:src="@drawable/ic_speed"
                            app:tint="@color/colorTextTertiary" />

                        <TextView
                            android:id="@+id/tvNivelRutina"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="@string/tvNivelRutina"
                            android:textColor="@color/colorTextStrong"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnIniciarEntrenamiento"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_standard"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:background="@drawable/bg_button_primary"
                    android:drawableStart="@drawable/ic_play_arrow"
                    android:drawablePadding="@dimen/spacing_sm"
                    app:drawableTint="@color/colorOnPrimary"
                    android:elevation="@dimen/elevation_button"
                    android:letterSpacing="0.05"
                    android:text="@string/btnIniciarEntrenamiento"
                    android:textAllCaps="true"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Lista de ejercicios con divisores -->
            <LinearLayout
                android:id="@+id/cardListaEjercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layoutListaHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/colorSurfaceHeader"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/tvTituloLista"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tvTituloLista"
                        android:textColor="@color/colorTextStrong"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtituloLista"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tvSubtituloLista"
                        android:textColor="@color/colorTextTertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorBorder" />

                <!-- Ejercicio 1 -->
                <LinearLayout
                    android:id="@+id/layoutEjercicio1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvNumeroEjercicio1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_number_badge"
                        android:gravity="center"
                        android:text="@string/tvNumeroEjercicio1"
                        android:textColor="@color/colorTextStrong"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNombreEjercicio1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNombreEjercicio1"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetalleEjercicio1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvDetalleEjercicio1"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgReorder1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/tvNombreEjercicio1"
                        android:src="@drawable/ic_reorder"
                        app:tint="@color/colorTextDisabled" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider" />

                <!-- Ejercicio 2 -->
                <LinearLayout
                    android:id="@+id/layoutEjercicio2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvNumeroEjercicio2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_number_badge"
                        android:gravity="center"
                        android:text="@string/tvNumeroEjercicio2"
                        android:textColor="@color/colorTextStrong"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNombreEjercicio2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNombreEjercicio2"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetalleEjercicio2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvDetalleEjercicio2"
                            android:textColor="@color/colorTextTertiary"
