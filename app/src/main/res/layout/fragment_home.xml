                        android:layout_height="20dp"
                        android:contentDescription="@string/tvNombreEjercicio4"
                        android:src="@drawable/ic_reorder"
                        app:tint="@color/colorTextDisabled" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botones secundarios -->
            <LinearLayout
                android:id="@+id/layoutAcciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEditarRutina"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_compact"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_neutral"
                    android:letterSpacing="0.05"
                    android:text="@string/btnEditarRutina"
                    android:textAllCaps="true"
                    android:textColor="@color/colorTextStrong"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnNuevoEjercicio"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_compact"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_confirm"
