                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider" />

                <!-- Ejercicio 3 -->
                <LinearLayout
                    android:id="@+id/layoutEjercicio3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
