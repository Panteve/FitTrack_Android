                        android:id="@+id/tvNumeroEjercicio3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_number_badge"
                        android:gravity="center"
                        android:text="@string/tvNumeroEjercicio3"
                        android:textColor="@color/colorTextStrong"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNombreEjercicio3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNombreEjercicio3"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetalleEjercicio3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvDetalleEjercicio3"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgReorder3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/tvNombreEjercicio3"
                        android:src="@drawable/ic_reorder"
                        app:tint="@color/colorTextDisabled" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider" />

                <!-- Ejercicio 4 -->
                <LinearLayout
                    android:id="@+id/layoutEjercicio4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvNumeroEjercicio4"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_number_badge"
                        android:gravity="center"
                        android:text="@string/tvNumeroEjercicio4"
                        android:textColor="@color/colorTextStrong"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNombreEjercicio4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tvNombreEjercicio4"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetalleEjercicio4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvDetalleEjercicio4"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgReorder4"
