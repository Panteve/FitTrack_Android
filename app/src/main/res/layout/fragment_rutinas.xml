<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRutinas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/layoutContenidoRutinas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg">

        <!-- Acción principal -->
        <Button
            android:id="@+id/btnNuevaRutina"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_standard"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="@dimen/spacing_sm"
            android:elevation="@dimen/elevation_button"
            android:letterSpacing="0.05"
            android:text="@string/btnNuevaRutina"
            android:textAllCaps="true"
            android:textColor="@color/colorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:drawableTint="@color/colorOnPrimary" />

        <!-- Cabecera de planes -->
        <LinearLayout
            android:id="@+id/layoutCabeceraPlanes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTituloPlanes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tvTituloPlanes"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCantidadPlanes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="@drawable/bg_badge_teal"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="3dp"
                android:textColor="@color/colorOnPrimary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lista de planes de entrenamiento -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlanes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_xxl"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
