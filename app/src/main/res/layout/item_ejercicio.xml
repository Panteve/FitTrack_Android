<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutItemEjercicio"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:elevation="@dimen/elevation_card"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md">

    <ImageView
        android:id="@+id/imgIconoEjercicio"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_day_checked"
        android:contentDescription="@null"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_fitness_center"
        app:tint="@color/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tvNombreEjercicio"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tvSubtituloEjercicio"
            android:textColor="@color/colorTextTertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgChevronEjercicio"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/spacing_sm"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/colorIconSubtle" />
</LinearLayout>