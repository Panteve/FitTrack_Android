<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_lg"
    android:background="@drawable/bg_card"
    android:elevation="@dimen/elevation_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <!-- Cabecera de la tarjeta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgIconoPlan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_day_checked"
            android:contentDescription="@null"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_fitness_center"
            app:tint="@color/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombrePlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tvNombrePlan"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResumenPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tvResumenPlan"
                android:textColor="@color/colorTextTertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgMenuPlan"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:contentDescription="@string/cdMenuPlan"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/colorTextTertiary" />
    </LinearLayout>

    <!-- Lista de ejercicios del plan -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEjerciciosPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@drawable/bg_day_weekend"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@color/colorBorder" />

    <!-- Acciones de la tarjeta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVerDetalles"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_compact"
            android:background="@drawable/bg_button_neutral"
            android:letterSpacing="0.05"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:text="@string/btnVerDetalles"
            android:textAllCaps="true"
            android:textColor="@color/colorTextStrong"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnIniciarRutina"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_compact"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_play_arrow"
            android:drawablePadding="6dp"
            android:letterSpacing="0.05"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:text="@string/btnIniciarRutina"
            android:textAllCaps="true"
            android:textColor="@color/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:drawableTint="@color/colorOnPrimary" />
    </LinearLayout>
</LinearLayout>
