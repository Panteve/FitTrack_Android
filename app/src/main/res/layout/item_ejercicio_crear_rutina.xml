<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un ejercicio agregado a la rutina: nombre, cabecera de columnas y sus series. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEjercicioCrearRutina"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_card"
    android:elevation="@dimen/elevation_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <!-- Cabecera de la tarjeta: nombre del ejercicio y opción para quitarlo -->
    <LinearLayout
        android:id="@+id/layoutCabeceraEjercicioCrearRutina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreEjercicioRutinaEditable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tvNombreEjercicioRutinaEditable"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGrupoMuscularEjercicioRutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tvGrupoMuscularEjercicioRutina"
                android:textColor="@color/colorTextTertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnQuitarEjercicioRutina"
            android:layout_width="@dimen/boton_icono_serie_width"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cdQuitarEjercicioRutina"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="@color/colorErrorText" />
    </LinearLayout>

    <!-- Cabecera de las columnas: el espacio del número mantiene las etiquetas alineadas con los campos. -->
    <LinearLayout
        android:id="@+id/layoutCabeceraSeries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewEspacioNumeroSerie"
            android:layout_width="@dimen/badge_number_size"
            android:layout_height="@dimen/badge_number_size"
            android:layout_marginEnd="@dimen/spacing_sm" />

        <TextView
            android:id="@+id/tvCabeceraPesoObjetivo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="@string/tvCabeceraPesoObjetivo"
            android:textColor="@color/colorTextTertiary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCabeceraRepeticiones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="0.8"
            android:gravity="center"
            android:text="@string/tvCabeceraRepeticiones"
            android:textColor="@color/colorTextTertiary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Espacio del botón de quitar serie, para que las etiquetas no se corran. -->
        <View
            android:id="@+id/viewEspacioQuitarSerie"
            android:layout_width="@dimen/boton_icono_serie_width"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/spacing_sm" />
    </LinearLayout>

    <!-- Las filas de series se inflan desde CrearRutinaEjercicioAdapter. -->
    <LinearLayout
        android:id="@+id/layoutSeriesEjercicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:orientation="vertical" />

    <Button
        android:id="@+id/btnAgregarSerie"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_standard"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@drawable/bg_button_confirm"
        android:drawableStart="@drawable/ic_add"
        android:drawablePadding="@dimen/spacing_sm"
        android:letterSpacing="0.05"
        android:text="@string/btnAgregarSerie"
        android:textAllCaps="true"
        android:textColor="@color/colorOnConfirm"
        android:textSize="13sp"
        android:textStyle="bold"
        app:drawableTint="@color/colorOnConfirm" />
</LinearLayout>
