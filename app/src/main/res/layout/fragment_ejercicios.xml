<?xml version="1.0" encoding="utf-8"?>
<!-- Selector de ejercicios: buscador y filtros arriba, y abajo los ejercicios del usuario y los
     del sistema en dos secciones separadas, para que nunca se mezclen.
     El desplazamiento es de toda la pantalla, por eso los dos RecyclerView se ajustan a su
     contenido y no hacen scroll propio. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutEjercicios"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Estado de carga: se muestra mientras se consultan los ejercicios disponibles -->
    <ProgressBar
        android:id="@+id/pbCargaEjercicios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="gone" />

    <!-- Estado de error: mensaje y reintento cuando la consulta no pudo completarse -->
    <LinearLayout
        android:id="@+id/layoutErrorCargaEjercicios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorCargaEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tvErrorCargaEjercicios"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnReintentarCargaEjercicios"
            style="@style/FitTrack.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/btnReintentarCargaEjercicios" />
    </LinearLayout>

    <!-- Estado exitoso: buscador, filtros y las dos secciones de ejercicios -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svEjercicios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutContenidoEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_lg">

            <!-- Buscador -->
            <EditText
                android:id="@+id/etBuscarEjercicio"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:autofillHints="name"
                android:background="@drawable/bg_input"
                android:contentDescription="@string/cdBuscarEjercicio"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="@dimen/spacing_sm"
                android:hint="@string/etBuscarEjercicio_hint"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/spacing_md"
                android:singleLine="true"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextStrong"
                android:textSize="14sp"
                app:drawableTint="@color/colorTextTertiary" />

            <!-- Filtros: se desplazan en horizontal para que los cinco quepan sin comprimirse -->
            <HorizontalScrollView
                android:id="@+id/svChipsEjercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutChipsEjercicios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvChipTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_filter_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:paddingVertical="8dp"
                        android:text="@string/tvChipTodos"
                        android:textAllCaps="true"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChipPecho"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_filter_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:paddingVertical="8dp"
                        android:text="@string/tvChipPecho"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTextStrong"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChipEspalda"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_filter_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:paddingVertical="8dp"
                        android:text="@string/tvChipEspalda"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTextStrong"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChipPierna"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_filter_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:paddingVertical="8dp"
                        android:text="@string/tvChipPierna"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTextStrong"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChipBrazo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@drawable/bg_filter_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:paddingVertical="8dp"
                        android:text="@string/tvChipBrazo"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTextStrong"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Sección 1: ejercicios creados por el usuario -->
            <TextView
                android:id="@+id/tvTituloMisEjercicios"
                style="@style/FitTrack.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/tvTituloMisEjercicios" />

            <TextView
                android:id="@+id/tvSinMisEjercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/tvSinMisEjercicios"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMisEjercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Sección 2: ejercicios que trae el sistema -->
            <TextView
                android:id="@+id/tvTituloEjerciciosSistema"
                style="@style/FitTrack.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:text="@string/tvTituloEjerciciosSistema" />

            <TextView
                android:id="@+id/tvSinEjerciciosSistema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/tvSinEjerciciosSistema"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEjerciciosSistema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxl" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
