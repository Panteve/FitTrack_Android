<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutEjercicios"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/layoutContenidoEjercicios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg">

        <!-- Buscador -->
        <EditText
            android:id="@+id/etBuscarEjercicio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_standard"
            android:autofillHints="name"
            android:background="@drawable/bg_input"
            android:contentDescription="@string/cdBuscarEjercicio"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/spacing_sm"
            android:hint="@string/etBuscarEjercicio_hint"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/spacing_md"
            android:singleLine="true"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextStrong"
            android:textSize="14sp"
            app:drawableTint="@color/colorTextTertiary" />

        <!-- Filtros -->
        <LinearLayout
            android:id="@+id/layoutChipsEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvChipTodos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/tvChipTodos"
                android:textColor="@color/colorOnPrimary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChipPecho"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/tvChipPecho"
                android:textColor="@color/colorTextStrong"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChipEspalda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/tvChipEspalda"
                android:textColor="@color/colorTextStrong"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChipPierna"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/tvChipPierna"
                android:textColor="@color/colorTextStrong"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lista de ejercicios -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEjercicios"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_xxl"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>