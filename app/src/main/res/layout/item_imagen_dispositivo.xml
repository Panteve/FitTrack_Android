<?xml version="1.0" encoding="utf-8"?>
<!-- Celda de la cuadrícula de la galería: la miniatura llena la celda con recorte
     central. La altura la calcula el adaptador para que cada celda quede cuadrada. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutImagenDispositivo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/imgImagenDispositivo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:background="@drawable/bg_input"
        android:contentDescription="@string/cdImagenDispositivo"
        android:scaleType="centerCrop" />
</FrameLayout>