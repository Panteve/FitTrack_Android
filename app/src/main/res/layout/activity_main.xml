<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Toolbar: 44dp teal #008577, con volver (opcional), título y acción (opcional).
         Es un FrameLayout para que el título quede centrado respecto a toda la barra
         y no al espacio sobrante entre los botones. -->
    <FrameLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/colorPrimary"
        android:elevation="4dp">

        <!-- Título: se dibuja primero (queda al fondo) y reserva un ancho igual a cada
             lado, así nunca se solapa con la flecha de volver ni con el botón de acción. -->
        <TextView
            android:id="@+id/tvToolbarTituloMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/toolbar_side_reserved"
            android:text="@string/tvToolbarTituloMain"
            android:textColor="@color/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnVolverToolbar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cdVolver"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            app:tint="@color/colorOnPrimary" />

        <Button
            android:id="@+id/btnAccionToolbar"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:background="@drawable/bg_button_neutral"
            android:letterSpacing="0.05"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/spacing_md"
            android:textAllCaps="true"
            android:textColor="@color/colorTextStrong"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Contenedor del fragment (centrado verticalmente para login) -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical" />

    <!-- Barra de navegación inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:menu="@menu/bottom_navigation_menu" />
</LinearLayout>