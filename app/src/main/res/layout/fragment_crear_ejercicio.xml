<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutCrearEjercicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ScrollView
        android:id="@+id/svCrearEjercicio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutContenidoCrearEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Multimedia -->
            <LinearLayout
                android:id="@+id/cardMultimediaEjercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md">

                <ImageButton
                    android:id="@+id/btnMultimediaEjercicio"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_image"
                    android:contentDescription="@string/cdMultimediaEjercicio"
                    android:padding="20dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tvCardMultimedia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:text="@string/tvCardMultimedia"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nombre del ejercicio -->
            <TextView
                android:id="@+id/tvLabelNombreEjercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/tvLabelNombreEjercicio"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNombreEjercicio"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="@dimen/spacing_xs"
                android:autofillHints="name"
                android:background="@drawable/bg_input"
                android:hint="@string/etNombreEjercicio_hint"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/spacing_md"
                android:singleLine="true"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextStrong"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvErrorNombreEjercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/tvErrorNombreEjercicio"
                android:textColor="@color/colorError"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Campos del ejercicio -->
            <LinearLayout
                android:id="@+id/cardCamposEjercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:id="@+id/layoutCampoGrupoMuscular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLabelGrupoMuscular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tvLabelGrupoMuscular"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvValorGrupoMuscular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvValorGrupoMuscular"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgChevronGrupoMuscular"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:contentDescription="@string/cdGrupoMuscular"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/colorIconSubtle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider" />

                <LinearLayout
                    android:id="@+id/layoutCampoTipoEquipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLabelTipoEquipo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tvLabelTipoEquipo"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvValorTipoEquipo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvValorTipoEquipo"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgChevronTipoEquipo"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:contentDescription="@string/cdTipoEquipo"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/colorIconSubtle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider" />

                <LinearLayout
                    android:id="@+id/layoutCampoPeso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLabelPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tvLabelPeso"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvValorPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvValorPeso"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgChevronPeso"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:contentDescription="@string/cdPeso"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/colorIconSubtle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider" />

                <LinearLayout
                    android:id="@+id/layoutCampoRepeticiones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLabelRepeticiones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tvLabelRepeticiones"
                            android:textColor="@color/colorTextTertiary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvValorRepeticiones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tvValorRepeticiones"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgChevronRepeticiones"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:contentDescription="@string/cdRepeticiones"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/colorIconSubtle" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxl" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>