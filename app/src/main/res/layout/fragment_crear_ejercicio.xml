<?xml version="1.0" encoding="utf-8"?>
<!-- Crear ejercicio: solo pide el nombre y el grupo muscular, que son los únicos datos
     que el backend necesita para registrar el ejercicio.
     La acción GUARDAR pertenece a la toolbar de MainActivity, por eso aquí no se dibuja. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCrearEjercicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ScrollView
        android:id="@+id/svCrearEjercicio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutContenidoCrearEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Campo nombre del ejercicio -->
            <TextView
                android:id="@+id/tvLabelNombreEjercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvLabelNombreEjercicio"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNombreEjercicio"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="@dimen/spacing_xs"
                android:autofillHints="name"
                android:background="@drawable/bg_input"
                android:hint="@string/etNombreEjercicio_hint"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/spacing_md"
                android:singleLine="true"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextStrong"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvErrorNombreEjercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/tvErrorNombreEjercicio"
                android:textColor="@color/colorError"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Campo grupo muscular -->
            <TextView
                android:id="@+id/tvLabelGrupoMuscular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/tvLabelGrupoMuscular"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spGrupoMuscular"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="@dimen/spacing_md"
                android:spinnerMode="dropdown" />

            <TextView
                android:id="@+id/tvErrorGrupoMuscular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/tvErrorGrupoMuscular"
                android:textColor="@color/colorError"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Indicador de guardado: solo se ve mientras se espera la respuesta del backend -->
            <ProgressBar
                android:id="@+id/pbGuardarEjercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_xl"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_xxl" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
