<?xml version="1.0" encoding="utf-8"?>
<!-- Misma estructura visual que Crear rutina, pero con los datos de la rutina ya cargados
     y un botón para borrarla al final de todo el contenido. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutModificarRutina"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ScrollView
        android:id="@+id/svModificarRutina"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <!-- layout_height="match_parent" + fillViewport: cuando la pantalla queda vacía,
             el espacio sobrante se reparte y el estado vacío puede quedar centrado. -->
        <LinearLayout
            android:id="@+id/layoutContenidoModificarRutina"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Nombre de la rutina que se está modificando -->
            <TextView
                android:id="@+id/tvLabelNombreRutina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvLabelNombreRutina"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNombreRutina"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="@dimen/spacing_xs"
                android:autofillHints="name"
                android:background="@drawable/bg_input"
                android:hint="@string/etNombreRutina_hint"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/spacing_md"
                android:singleLine="true"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextStrong"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvErrorNombreRutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/tvErrorNombreRutina"
                android:textColor="@color/colorError"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Día de entrenamiento. La opción inicial es un texto de ayuda:
                 no es un día válido y por eso nunca se envía al backend. -->
            <TextView
                android:id="@+id/tvLabelDiaRutina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/tvLabelDiaRutina"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spDiaRutina"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_standard"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_input"
                android:entries="@array/spDiaRutina_opciones"
                android:paddingHorizontal="@dimen/spacing_md"
                android:spinnerMode="dropdown" />

            <TextView
                android:id="@+id/tvErrorDiaRutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/tvErrorDiaRutina"
                android:textColor="@color/colorError"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Estado vacío: se muestra únicamente cuando la rutina no tiene ejercicios. -->
            <LinearLayout
                android:id="@+id/layoutRutinaSinEjercicios"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRutinaSinEjercicios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/tvRutinaSinEjercicios"
                    android:textColor="@color/colorTextTertiary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnAgregarPrimerEjercicio"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_standard"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:background="@drawable/bg_button_primary"
                    android:drawableStart="@drawable/ic_add"
                    android:drawablePadding="@dimen/spacing_sm"
                    android:elevation="@dimen/elevation_button"
                    android:letterSpacing="0.05"
                    android:paddingHorizontal="@dimen/spacing_xxl"
                    android:text="@string/btnAgregarPrimerEjercicio"
                    android:textAllCaps="true"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/colorOnPrimary" />
            </LinearLayout>

            <!-- Estado con ejercicios: se muestra cuando la rutina ya tiene al menos uno. -->
            <LinearLayout
                android:id="@+id/layoutRutinaConEjercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTituloEjerciciosRutina"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxl"
                    android:text="@string/tvTituloEjerciciosRutina"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- El desplazamiento lo maneja svModificarRutina, por eso el RecyclerView
                     se ajusta a su contenido y no hace scroll propio. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEjerciciosRutina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <Button
                    android:id="@+id/btnAgregarEjercicio"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_standard"
                    android:background="@drawable/bg_button_primary"
                    android:drawableStart="@drawable/ic_add"
                    android:drawablePadding="@dimen/spacing_sm"
                    android:elevation="@dimen/elevation_button"
                    android:letterSpacing="0.05"
                    android:text="@string/btnAgregarEjercicio"
                    android:textAllCaps="true"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/colorOnPrimary" />
            </LinearLayout>

            <!-- Borrar la rutina. Va al final de todo el contenido desplazable, no en la
                 toolbar, para que quede lejos del guardado y se lea como una acción aparte. -->
            <Button
                android:id="@+id/btnBorrarRutina"
                style="@style/FitTrack.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:text="@string/btnBorrarRutina" />
        </LinearLayout>
    </ScrollView>

    <!-- Estado de error: mensaje y reintento cuando el detalle no pudo consultarse. -->
    <LinearLayout
        android:id="@+id/layoutErrorModificarRutina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorCargaModificarRutina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tvErrorCargaModificarRutina"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnReintentarModificarRutina"
            style="@style/FitTrack.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_standard"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/btnReintentarModificarRutina" />
    </LinearLayout>

    <!-- Capa de proceso: cubre toda la pantalla y, al ser clickable y focusable, impide
         cambiar o borrar algo mientras la petición está en vuelo. -->
    <FrameLayout
        android:id="@+id/layoutCargaModificarRutina"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorOverlayCarga"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pbModificarRutina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/colorPrimary" />
    </FrameLayout>
</FrameLayout>
