<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_sm">

    <View
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_dot_teal" />

    <TextView
        android:id="@+id/tvNombreEjercicioRutina"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/tvNombreEjercicioRutina"
        android:textColor="@color/colorTextPrimary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvSeriesEjercicioRutina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:text="@string/tvSeriesEjercicioRutina"
        android:textColor="@color/colorTextTertiary"
        android:textSize="12sp" />
</LinearLayout>
